{
    "name": "My CodeSpace with Miniconda",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash"
            },
            "extensions": [
                "ms-python.python"
            ]
        }
    },
    "postCreateCommand": "conda init bash && source ~/.bashrc"
}